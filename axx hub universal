tabTroll:Section({ Title = "Fling", Icon = "solar:wind-bold" })
local currentFlingTarget = nil
local flingLoop = nil
local flingBV, flingBAV

local function isPlayerInGame(p)
    if not p or p == player then return false end
    if not p.Parent then return false end
    local char = p.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return false end
    if hum.Health <= 0 then return false end
    return true
end

local function getInGamePlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if isPlayerInGame(p) then
            table.insert(list, p)
        end
    end
    return list
end

local function stopFling()
    currentFlingTarget = nil
    if flingLoop then flingLoop:Disconnect(); flingLoop = nil end
    if flingBV then pcall(function() flingBV:Destroy() end); flingBV = nil end
    if flingBAV then pcall(function() flingBAV:Destroy() end); flingBAV = nil end
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    pcall(function()
                        v.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5, 1, 1)
                    end)
                    v.CanCollide = true
                end
            end
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function startFling(targetMode)
    stopFling()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    hum.PlatformStand = true
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            pcall(function()
                v.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5, 1, 1)
            end)
        end
    end
    flingBAV = Instance.new("BodyAngularVelocity")
    flingBAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flingBAV.AngularVelocity = Vector3.new(0, 99999, 0)
    flingBAV.Parent = hrp
    flingBV = Instance.new("BodyVelocity")
    flingBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flingBV.Velocity = Vector3.zero
    flingBV.Parent = hrp
    currentFlingTarget = targetMode
    local allIndex = 1
    local tickCounter = 0
    flingLoop = RunService.Heartbeat:Connect(function()
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            stopFling(); return
        end
        local pHum = player.Character:FindFirstChildOfClass("Humanoid")
        if not pHum or pHum.Health <= 0 then stopFling(); return end
        local myHrp = player.Character.HumanoidRootPart
        myHrp.AssemblyAngularVelocity = Vector3.new(0, 99999, 0)
        for _, v in pairs(player.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
        if type(currentFlingTarget) == "userdata" then
            if isPlayerInGame(currentFlingTarget) then
                myHrp.CFrame = currentFlingTarget.Character.HumanoidRootPart.CFrame
                    * CFrame.new(math.random(-1,1), math.random(-1,1), math.random(-1,1))
            else
                stopFling()
            end
        elseif currentFlingTarget == "All" then
            local validTargets = getInGamePlayers()
            if #validTargets > 0 then
                tickCounter = tickCounter + 1
                if tickCounter > 15 then allIndex = allIndex + 1; tickCounter = 0 end
                if allIndex > #validTargets then allIndex = 1 end
                myHrp.CFrame = validTargets[allIndex].Character.HumanoidRootPart.CFrame
                    * CFrame.new(math.random(-1,1), math.random(-1,1), math.random(-1,1))
            else
                stopFling()
            end
        end
    end)
end

