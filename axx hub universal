                    value = ("[%s](https://www.roblox.com/games/%d)\n**PlaceId:** %d"):format(gameName, game.PlaceId, game.PlaceId),
                    inline = false
                },
                { name = "Executor", value = executor, inline = false },
                { name = "Message", value = string.sub(message, 1, 1000), inline = false },
            },
            timestamp = DateTime.now():ToIsoDate()
        }

        return pcall(function()
            httpRequest({
                Url = WEBHOOK,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ username = "Captain Hook", embeds = { embed } })
            })
        end)
    end

