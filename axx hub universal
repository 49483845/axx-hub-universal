local fakeNameEnabled = false
local customFakeName = "Tu Nombre"
local fakeNameMode = "Cambiar solo para mí"
local fakeNameActive = false
local fakeOriginalData = {}
local fakeVisualConnections = {}
local fakeWatchedTexts = setmetatable({}, { __mode = "k" })
local fakeReplacePairs = {}
local fakeNames = {}
local fakeCounter = 0
local fakeHumanoidOriginals = setmetatable({}, { __mode = "k" })
local fakeScanId = 0
local TEXT_CLASSES = { TextLabel = true, TextBox = true, TextButton = true }

local function fakeSafeReplace(str, find, replace)
    local safeFind = find:gsub("[%-%^%$%(%)%%%.%[%]%*%+%?]", "%%%1")
    local safeRep = replace:gsub("%%", "%%%%")
    return (str:gsub(safeFind, safeRep))
end

local function fakeIsText(v) return TEXT_CLASSES[v.ClassName] == true end

local function fakeIsOwnRoot(inst)
    return string.find(inst.Name, "WindUI", 1, true) ~= nil or string.find(inst.Name, "Axx", 1, true) ~= nil
end

local function fakeIsOwnGui(v)
    local pg = v:FindFirstAncestorWhichIsA("ScreenGui")
    if pg and (string.find(pg.Name, "WindUI") or string.find(pg.Name, "Axx")) then return true end
    return false
end

local function fakeBaseName()
    local n = tostring(customFakeName or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if n == "" then return "Anon" end
    return n
end

local function fakeAssign(p)
    if not fakeNames[p] then
        fakeCounter += 1
        fakeNames[p] = fakeBaseName() .. "-" .. fakeCounter
    end
    return fakeNames[p]
end

local function fakeFor(p)
    if fakeNameMode == "Cambiar solo para mí" then
        if p == player then
            return fakeBaseName()
        end
        return p.Name
    end
    if p == player then return fakeBaseName() end
    if #Players:GetPlayers() <= 1 then return fakeBaseName() end
    return fakeAssign(p)
end

local function fakeRebuildPairs()
    table.clear(fakeReplacePairs)
    for _, p in ipairs(Players:GetPlayers()) do
        local fake = fakeFor(p)
        if fake ~= p.Name then
            if p.Name ~= "" then
                fakeReplacePairs[#fakeReplacePairs+1] = { find = p.Name, fake = fake }
            end
            if p.DisplayName ~= "" and p.DisplayName ~= p.Name then
                fakeReplacePairs[#fakeReplacePairs+1] = { find = p.DisplayName, fake = fake }
            end
        end
    end
    table.sort(fakeReplacePairs, function(a,b) return #a.find > #b.find end)
    for i, pair in ipairs(fakeReplacePairs) do
        pair.token = "\1" .. i .. "\2"
    end
end

local function fakeApplyReplace(text)
    local out = text
    for _, pair in ipairs(fakeReplacePairs) do out = fakeSafeReplace(out, pair.find, pair.token) end
    for _, pair in ipairs(fakeReplacePairs) do out = fakeSafeReplace(out, pair.token, pair.fake) end
    return out
end

local function fakeProcessText(v, trusted)
    if not fakeIsText(v) then return end
    if not trusted and fakeIsOwnGui(v) then return end
    local data = fakeOriginalData[v]
    if not data then
        local txt = v.Text
        if not txt or txt == "" then return end
        local hasName = false
        for _, pair in ipairs(fakeReplacePairs) do
            if string.find(txt, pair.find, 1, true) then hasName = true; break end
        end
        if not hasName then return end
        data = { Text = txt, Applied = nil }
        fakeOriginalData[v] = data
    end
    if fakeNameActive then
        local newText = fakeApplyReplace(data.Text)
        data.Applied = newText
        if v.Text ~= newText then v.Text = newText end
    else
        if v.Text ~= data.Text then v.Text = data.Text end
        fakeOriginalData[v] = nil
    end
end

local function fakeWatch(v)
    if fakeWatchedTexts[v] or not fakeIsText(v) then return end
    fakeWatchedTexts[v] = true
    table.insert(fakeVisualConnections, v:GetPropertyChangedSignal("Text"):Connect(function()
        if not fakeNameActive then return end
        local data = fakeOriginalData[v]
        if data and v.Text == data.Applied then return end
        fakeOriginalData[v] = nil
        fakeProcessText(v)
    end))
end

local function fakeFullScan()
    fakeScanId += 1
    local myScan = fakeScanId
    for v in pairs(fakeOriginalData) do
        if v.Parent then fakeProcessText(v) else fakeOriginalData[v] = nil end
    end
    local roots = {}
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        for _, c in ipairs(pGui:GetChildren()) do
            if not fakeIsOwnRoot(c) then roots[#roots+1] = c end
        end
    end
    local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if okCore and coreGui then
        local okKids, kids = pcall(function() return coreGui:GetChildren() end)
        if okKids then
            for _, c in ipairs(kids) do
                if not fakeIsOwnRoot(c) then roots[#roots+1] = c end
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then roots[#roots+1] = p.Character end
    end
    local sliceStart = os.clock()
    for _, root in ipairs(roots) do
        local okDesc, desc = pcall(function() return root:GetDescendants() end)
        if okDesc then
            for i = 1, #desc do
                local v = desc[i]
                if TEXT_CLASSES[v.ClassName] then
                    fakeProcessText(v, true)
                    fakeWatch(v)
                end
                if os.clock() - sliceStart > 0.006 then
                    task.wait()
                    if not fakeNameActive or myScan ~= fakeScanId then return end
                    sliceStart = os.clock()
                end
            end
        end
    end
end

local function fakeQuickRefresh()
    fakeScanId += 1
    local myScan = fakeScanId
    local list = {}
    for v in pairs(fakeWatchedTexts) do list[#list+1] = v end
    local sliceStart = os.clock()
    for i = 1, #list do
        local v = list[i]
        if v.Parent then fakeProcessText(v, true) else fakeOriginalData[v] = nil end
        if os.clock() - sliceStart > 0.006 then
            task.wait()
            if not fakeNameActive or myScan ~= fakeScanId then return end
            sliceStart = os.clock()
        end
    end
end

local function fakeOnAdded(obj)
    if not fakeNameActive then return end
    if fakeIsText(obj) then
        task.spawn(function()
            if not fakeNameActive then return end
            if fakeIsOwnGui(obj) then return end
            fakeProcessText(obj, true)
            fakeWatch(obj)
        end)
    end
end

local function fakeApplyHumanoidNames()
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            local fake = fakeFor(p)
            if fake ~= p.Name then
                if fakeHumanoidOriginals[hum] == nil then
                    fakeHumanoidOriginals[hum] = hum.DisplayName
                end
                if hum.DisplayName ~= fake then hum.DisplayName = fake end
            elseif fakeHumanoidOriginals[hum] ~= nil then
                pcall(function() hum.DisplayName = fakeHumanoidOriginals[hum] end)
                fakeHumanoidOriginals[hum] = nil
            end
        end
    end
end

local function fakeRestoreHumanoidNames()
    for hum, name in pairs(fakeHumanoidOriginals) do
        if hum.Parent then pcall(function() hum.DisplayName = name end) end
    end
    table.clear(fakeHumanoidOriginals)
end

local function fakeConnectWatchers()
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then table.insert(fakeVisualConnections, pGui.DescendantAdded:Connect(fakeOnAdded)) end
    pcall(function()
        local cg = game:GetService("CoreGui")
        table.insert(fakeVisualConnections, cg.DescendantAdded:Connect(fakeOnAdded))
    end)
    local function hookChar(p)
        table.insert(fakeVisualConnections, p.CharacterAdded:Connect(function(char)
            if not fakeNameActive then return end
            local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
            if not hum or not fakeNameActive then return end
            local fake = fakeFor(p)
            if fake ~= p.Name then
                if fakeHumanoidOriginals[hum] == nil then
                    fakeHumanoidOriginals[hum] = hum.DisplayName
                end
                if hum.DisplayName ~= fake then hum.DisplayName = fake end
            end
        end))
    end
    for _, p in ipairs(Players:GetPlayers()) do hookChar(p) end
    local function playersChanged()
        if not fakeNameActive then return end
        fakeRebuildPairs()
        pcall(fakeApplyHumanoidNames)
        task.spawn(fakeQuickRefresh)
        task.delay(0.5, function()
            if fakeNameActive then task.spawn(fakeFullScan) end
        end)
    end
    table.insert(fakeVisualConnections, Players.PlayerAdded:Connect(function(p)
        hookChar(p)
        playersChanged()
    end))
    table.insert(fakeVisualConnections, Players.PlayerRemoving:Connect(function()
        task.defer(playersChanged)
    end))
end

local function fakeStartLoop()
    task.spawn(function()
        while fakeNameActive do
            pcall(fakeApplyHumanoidNames)
            task.wait(0.3)
        end
    end)
end

local function fakeUpdateSystem()
    if fakeNameEnabled then
        if not fakeNameActive then
            fakeNameActive = true
            table.clear(fakeNames)
            fakeCounter = 0
            fakeRebuildPairs()
            fakeConnectWatchers()
            fakeStartLoop()
        else
            table.clear(fakeNames)
            fakeCounter = 0
            fakeRebuildPairs()
        end
        task.spawn(fakeFullScan)
    elseif fakeNameActive then
        fakeNameActive = false
        for _, c in ipairs(fakeVisualConnections) do c:Disconnect() end
        fakeVisualConnections = {}
        table.clear(fakeWatchedTexts)
        for v, data in pairs(fakeOriginalData) do
            if v and v.Parent and v.Text ~= data.Text then
                pcall(function() v.Text = data.Text end)
            end
        end
        fakeOriginalData = {}
        fakeRestoreHumanoidNames()
        table.clear(fakeReplacePairs)
        table.clear(fakeNames)
        fakeCounter = 0
    end
end

local function fakeRefreshMode()
    if not fakeNameEnabled then return end
    table.clear(fakeNames)
    fakeCounter = 0
    fakeRebuildPairs()
    pcall(fakeApplyHumanoidNames)
    task.spawn(fakeFullScan)
end

