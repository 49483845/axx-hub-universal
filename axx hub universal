local function extraerRobloxId(texto)
    if not texto then return nil end
    texto = tostring(texto):gsub("^%s+", ""):gsub("%s+$", "")
    if texto == "" then return nil end

    local soloNumero = texto:match("^(%d+)$")
    if soloNumero then return soloNumero end

    local rbxId = texto:match("rbxassetid://(%d+)")
    if rbxId then return rbxId end

    local libId = texto:match("roblox%.com/library/(%d+)")
    if libId then return libId end

    local assetId = texto:match("roblox%.com/asset/?%??id=(%d+)")
    if assetId then return assetId end

    local anyId = texto:match("[%?&]id=(%d+)")
    if anyId then return anyId end

    return nil
end

local function esPinterest(texto)
    if not texto then return false end
    local t = tostring(texto):lower()
    return t:find("pinterest.", 1, true) ~= nil
        or t:find("pin.it", 1, true) ~= nil
        or t:find("pinimg.com", 1, true) ~= nil
end

local function extraerUrlPinterest(texto)
    if not texto then return nil end
    local directa = texto:match("(https?://[%w%-_%.]*pinimg%.com/[^%s\"'<>]+)")
    if directa then return directa end
    return nil
end

