        if not httpRequest then return false, "Tu executor no soporta HTTP" end

        local executor = (identifyexecutor and identifyexecutor()) or "Desconocido"
        local avatar = getAvatar(player.UserId)
        local gameName = getGameInfo()

        local embed = {
            title = "Axx Hub | Bug Report / Suggestion",
